{
  "name": "ayla-agent-companions",
  "version": "0.4.0",
  "private": true,
  "desktopName": "companion-studio.desktop",
  "type": "module",
  "description": "Live2D desktop companions with Herdr tracking and MCP commands",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node scripts/start.mjs",
